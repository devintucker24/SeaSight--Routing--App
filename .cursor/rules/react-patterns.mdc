### Conditional Styling
```typescript
// ✅ Use conditional classes for state-based styling
export default function RoutePlanner({ isExpanded, isCalculating }: RoutePlannerProps) {
  return (
    <div className={`
      route-planner 
      ${isExpanded ? 'route-planner--expanded' : ''}
      ${isCalculating ? 'route-planner--calculating' : ''}
    `}>
      <button 
        className={`
          solve-button 
          ${isCalculating ? 'solve-button--disabled' : ''}
        `}
        disabled={isCalculating}
      >
        {isCalculating ? '⚓ Calculating...' : '⚓ Solve Route'}
      </button>
    </div>
  );
}
```