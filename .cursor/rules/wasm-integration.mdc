## 📊 Performance Monitoring

### WASM Performance Tracking
```typescript
// ✅ Monitor WASM performance
export const trackWasmPerformance = (operation: string, fn: () => any) => {
  const start = performance.now();
  const result = fn();
  const end = performance.now();
  
  console.log(`WASM ${operation}: ${(end - start).toFixed(2)}ms`);
  
  return result;
};

// ✅ Use in service calls
export class RouterService {
  async solveRoute(waypoints: Waypoint[]): Promise<RouteResponse> {
    return trackWasmPerformance('solveRoute', () => {
      // WASM operation
      return this.router.solveIsochrone(request);
    });
  }
}
